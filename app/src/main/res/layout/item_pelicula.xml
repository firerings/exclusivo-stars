<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="14dp">

    <!-- ConstraintLayout solo para forzar la relación de aspecto real
         del poster (2:3) sobre el ancho que da GridLayoutManager — antes
         la CardView tenía una altura fija en dp sin importar el ancho
         real de la columna, así que centerCrop terminaba recortando el
         poster para llenar un rectángulo que no era 2:3. Con ambas
         dimensiones en 0dp y layout_constraintDimensionRatio, la altura
         se calcula siempre a partir del ancho real de la columna. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/poster_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="2:3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface">

            <ImageView
                android:id="@+id/poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <!-- Chip país/año/tipo integrado al poster (esquina superior
                 derecha) — ver Etiqueta.kt para el armado del texto.
                 Sin badge de "pendiente" acá a propósito, mismo criterio
                 que antes: la web tampoco lo muestra en la grilla. -->
            <TextView
                android:id="@+id/etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/badge_chip_background"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/gold"
                android:textSize="10sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Título debajo del poster (ya no encima, ver conversación de
         diseño: competía con el degradado y no se leía bien en móvil).
         minLines=2 + maxLines=2 reserva siempre el mismo alto tenga el
         título 1 o 2 líneas, para que las tarjetas de una misma fila
         queden alineadas parejo. -->
    <TextView
        android:id="@+id/titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:lineSpacingExtra="1dp"
        android:minLines="2"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
