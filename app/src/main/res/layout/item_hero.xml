<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/fondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Mismo degradado que ya usa la ficha de película, para que el -->
    <!-- hero se funda con el fondo oscuro del resto de Inicio. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_degradado" />

    <!-- Mismo contenido que .inicio-hero-contenido en la web: logo/título,
         meta (año · duración · Película), sinopsis y los botones
         Reproducir / + Mi lista, todo anclado abajo. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:orientation="vertical">

        <!-- Logo transparente de la película (logo.png), mismo criterio que -->
        <!-- el hero de la web: si existe, reemplaza al título en texto plano. -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="200dp"
            android:layout_height="90dp"
            android:layout_gravity="start"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sinopsis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="320dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/boton_reproducir"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▶ Reproducir"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/hero_btn_blanco_background"
                android:backgroundTint="@null" />

            <Button
                android:id="@+id/boton_mi_lista"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="＋ Mi lista"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/hero_btn_glass_background"
                android:backgroundTint="@null" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
