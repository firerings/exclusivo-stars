<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/fondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Mismo degradado que ya usa la ficha de película, para que el -->
    <!-- hero se funda con el fondo oscuro del resto de Inicio. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_degradado" />

    <!-- Logo transparente de la película (logo.png), mismo criterio que -->
    <!-- el hero de la web: si existe, reemplaza al título en texto plano. -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="200dp"
        android:layout_height="90dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:scaleType="fitStart"
        android:adjustViewBounds="true"
        android:visibility="gone"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="6"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

</FrameLayout>
