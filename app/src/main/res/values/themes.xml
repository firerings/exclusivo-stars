<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme.MaterialComponents (no Bridge) porque BottomNavigationView lo
         pide para resolver sus estilos internos. El resto de las pantallas
         no usa widgets de Material salvo esta, así que el cambio no debería
         notarse en nada más — siguen con sus drawables/colores propios. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorAccent">@color/gold</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>
</resources>
